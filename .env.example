SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxjaWlrZ3NpcnVtdHNqd3JxYWtsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIxMzE1ODcsImV4cCI6MjA5NzcwNzU4N30.m564wlTHRxhnxR17wHSzYytl42zCe06llXYVaLYpE7w"

# Public base URL of the deployed app (used for auth magic-link redirects).
# Local dev: http://localhost:3000  |  Prod: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Custom URL scheme for the native (Capacitor) app's magic-link deep links.
# Must match the scheme registered in the iOS/Android projects and be added to
# Supabase Auth redirect URLs as: <scheme>://auth/callback
NEXT_PUBLIC_APP_SCHEME="mutualtransfer"

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — custom transactional email (free tiers). Auth emails already work
# through Supabase's built-in mailer; this is only for "you have a new match"
# notifications. If unset, the app degrades gracefully (in-app notifications only).
# ─────────────────────────────────────────────────────────────────────────────
# RESEND_API_KEY=""
# NOTIFY_EMAIL_FROM="Mutual Transfer <notify@yourdomain.com>"

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — hover-to-Hindi translation. The feature works key-less out of the
# box via the free MyMemory API. Setting a contact email raises MyMemory's free
# daily quota (anonymous ~5k words/day → ~50k words/day). Safe to expose.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MYMEMORY_EMAIL=""

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — verification by official email domain. Comma-separated list of
# domains that auto-verify a profile (e.g. "hcourt.gov.in,districts.ecourts.gov.in").
# Leave empty to require admin manual verification for everyone.
# ─────────────────────────────────────────────────────────────────────────────
OFFICIAL_EMAIL_DOMAINS=""

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Razorpay monthly subscriptions (Premium tier).
# Leave blank to keep ALL features free; premium gating activates only once these
# are set. Create a Plan in the Razorpay Dashboard and paste its id below.
#   Dashboard → Settings → API Keys  (key id + secret)
#   Dashboard → Subscriptions → Plans  (create a monthly plan → plan_…)
#   Dashboard → Settings → Webhooks  (URL: <site>/api/webhooks/razorpay, secret)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=""        # rzp_test_… / rzp_live_… (public, used by Checkout)
RAZORPAY_KEY_SECRET=""                # server-only secret
RAZORPAY_PLAN_ID=""                   # plan_… (your monthly plan)
RAZORPAY_WEBHOOK_SECRET=""            # webhook signing secret
# RAZORPAY_TOTAL_COUNT="120"          # max billing cycles (default 120 months)

# Display only (shown on the Premium page).
NEXT_PUBLIC_PREMIUM_NAME="Mutual Transfer Premium"
NEXT_PUBLIC_PREMIUM_PRICE_LABEL="₹99 / month"
